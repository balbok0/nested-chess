# Copy to .env. Use a URL-safe password; keep .env outside version control.
POSTGRES_PASSWORD=replace_with_a_long_random_hex_password
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
# Production HTTPS overlay: set the domain, PUBLIC_URL=https://that-domain,
# COMPOSE_FILE=compose.yaml:compose.production.yaml.
# APP_DOMAIN=chess.example.com
# Optional sign-in providers; both values are required per provider.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
